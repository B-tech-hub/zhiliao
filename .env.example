# 登录密码（单用户）
APP_PASSWORD=change-me

# 会话签名密钥，>=32 字节随机串，可用 `openssl rand -hex 32` 生成
SESSION_SECRET=please-generate-a-random-32-byte-secret

# SQLite 数据库文件路径
DATABASE_PATH=./data/db/app.db

# 图片上传目录
UPLOAD_DIR=./data/uploads

# LLM 接入（OpenAI 兼容 Chat Completions 格式）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# 深度思考模型（模型名必须显式配置；接入点和 Key 可回落普通模型）
# REASONING_BASE_URL=
# REASONING_API_KEY=
# REASONING_MODEL=

# 视觉模型（可选，AI 读图用；接入点/Key 留空回落上方 LLM 配置）
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=qwen-vl-plus

# 图像模型（可选，AI 画图用；回落规则同视觉模型，只有填了模型名才启用）
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_MODEL=
# 生图请求超时，默认 180000（画图比对话慢得多）
# IMAGE_TIMEOUT_MS=180000

# 语义检索 Embedding（可选；三项必须全部显式配置，不回落 LLM_*）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_TIMEOUT_MS=60000

# 时区。不设时容器按 UTC 走，「每周回顾」也会按 UTC 分周——北京时间周一
# 早上 8 点之前记的笔记会被算进上一周。按本地时间分周请显式设置
# TZ=Asia/Shanghai

# AI 分类置信度阈值，低于该值归入未分类
AI_CONFIDENCE_THRESHOLD=0.6

PORT=3000
NOTES_EXPORT_DIR=./data/notes
