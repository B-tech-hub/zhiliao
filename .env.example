# 登录密码（单用户）
APP_PASSWORD=change-me

# 会话签名密钥，>=32 字节随机串，可用 `openssl rand -hex 32` 生成
SESSION_SECRET=please-generate-a-random-32-byte-secret

# SQLite 数据库文件路径
DATABASE_PATH=./data/db/app.db

# 图片上传目录
UPLOAD_DIR=./data/uploads

# LLM 接入（OpenAI 兼容 Chat Completions 格式）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# 视觉模型（可选，AI 读图用；接入点/Key 留空回落上方 LLM 配置）
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=qwen-vl-plus

# AI 分类置信度阈值，低于该值归入未分类
AI_CONFIDENCE_THRESHOLD=0.6

PORT=3000
