{
  "story": "2.2",
  "recorded_at": "2026-09-12T04:59:16.595Z",
  "status": "observed",
  "scope": "只读比较 WSL 内核原始与经补偿单调时钟；adjtimex modes=0，不写参数、不启动容器",
  "debug_tag": "DEBUG-clock-a2",
  "python_probe": "\nimport ctypes, json, os, sys, time\nfrom pathlib import Path\nclass Timeval(ctypes.Structure):\n    _fields_ = [(\"tv_sec\", ctypes.c_long), (\"tv_usec\", ctypes.c_long)]\nclass TimexPrefix(ctypes.Structure):\n    _fields_ = [(\"modes\", ctypes.c_uint), (\"offset\", ctypes.c_long), (\"freq\", ctypes.c_long),\n                (\"maxerror\", ctypes.c_long), (\"esterror\", ctypes.c_long), (\"status\", ctypes.c_int),\n                (\"constant\", ctypes.c_long), (\"precision\", ctypes.c_long), (\"tolerance\", ctypes.c_long),\n                (\"time\", Timeval), (\"tick\", ctypes.c_long)]\nassert ctypes.sizeof(ctypes.c_long) == 8\nlibc = ctypes.CDLL(None, use_errno=True)\nlibc.adjtimex.argtypes = [ctypes.c_void_p]\nlibc.adjtimex.restype = ctypes.c_int\nfor incoming in sys.stdin:\n    buf = ctypes.create_string_buffer(1024)\n    result = libc.adjtimex(ctypes.byref(buf))\n    value = TimexPrefix.from_buffer_copy(buf.raw)\n    print(json.dumps({\n        \"id\": incoming.strip(),\n        \"monotonic_ns\": str(time.clock_gettime_ns(time.CLOCK_MONOTONIC)),\n        \"raw_ns\": str(time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW)),\n        \"realtime_ns\": str(time.clock_gettime_ns(time.CLOCK_REALTIME)),\n        \"clocksource\": Path(\"/sys/devices/system/clocksource/clocksource0/current_clocksource\").read_text().strip(),\n        \"timex\": {\"modes_input\": 0, \"result\": result, \"errno\": ctypes.get_errno(),\n                  \"user_hz\": os.sysconf(\"SC_CLK_TCK\"), \"tick_us\": value.tick,\n                  \"freq_scaled_ppm\": value.freq, \"freq_ppm\": value.freq / 65536,\n                  \"status\": value.status, \"offset\": value.offset}\n    }), flush=True)\n",
  "python_probe_sha256": "57ab2341b1163b4fe5d4f7f1dfa9a531fa67398edb592415a60a4c435d25e218",
  "hypotheses": [
    "内核频率补偿：CLOCK_MONOTONIC 比 CLOCK_MONOTONIC_RAW 快，原始时钟应与宿主机接近。",
    "WSL 原始时钟失真：原始和经补偿时钟都应相对宿主机偏快。",
    "Node 探针口径问题：Python 直接系统时钟应不重现 Node 的偏差。"
  ],
